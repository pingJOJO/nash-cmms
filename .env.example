# ==============================================================================
# NASH CMMS - Production Environment Configuration
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=3000

# AWS RDS PostgreSQL Connection String
# Format: postgresql://[USERNAME]:[PASSWORD]@[RDS_ENDPOINT]:[PORT]/[DATABASE_NAME]?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:StrongPassword123@nash-cmms-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/nash_cmms?schema=public&sslmode=require"

# Optional Configuration
CORS_ORIGIN="*"
